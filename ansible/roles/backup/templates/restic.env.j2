# relative to the SFTP login directory: a sub-account is chrooted (its "/" is unreadable), so no leading slash
RESTIC_REPOSITORY=sftp:{{ storagebox_user }}@{{ storagebox_host }}:opi-k8s/restic
RESTIC_PASSWORD_FILE=/etc/restic/password
RESTIC_CACHE_DIR=/var/cache/restic
RESTIC_COMPRESSION=auto
# port, key and pinned host key: /etc/ssh/ssh_config.d/50-storagebox.conf
