// Managed by Ansible. Overrides /etc/apt/apt.conf.d/50unattended-upgrades.
// apt config LISTS MERGE across files: without #clear, Armbian's 50unattended-upgrades (all Debian updates +
// origin=Armbian, i.e. kernel/u-boot) would stay active and this file would only add to it.
#clear Unattended-Upgrade::Origins-Pattern;
Unattended-Upgrade::Origins-Pattern {
    "{{ updates_security_origin }}";
{% if updates_include_armbian_repo %}
    "origin=Armbian";
{% endif %}
};
Unattended-Upgrade::Package-Blacklist {
{% for p in updates_blacklist %}
    "{{ p }}";
{% endfor %}
};
Unattended-Upgrade::Automatic-Reboot "false";        // kured reboots nodes, one at a time, drained
Unattended-Upgrade::MinimalSteps "true";
Unattended-Upgrade::Remove-Unused-Kernel-Packages "true";
Unattended-Upgrade::Remove-Unused-Dependencies "true";
Unattended-Upgrade::SyslogEnable "true";
{% if updates_mail_to %}
Unattended-Upgrade::Mail "{{ updates_mail_to }}";
Unattended-Upgrade::MailReport "on-change";
{% endif %}
