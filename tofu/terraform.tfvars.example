kubeconfig_path = "../kubeconfig"

# Push this repo somewhere ArgoCD can reach (GitHub/GitLab/Gitea...) and put the URL here.
git_repo_url = "https://github.com/YOU/opi-k8s.git"
git_revision = "main"
# git_ssh_private_key = file("~/.ssh/opi-k8s-deploy-key")   # private repo via SSH URL

# grafana_admin_password = "something-strong"                 # empty = random, `make grafana-password`

# Tailscale operator (optional) — setting a client id enables it
# tailscale_oauth_client_id     = "k..."
# tailscale_oauth_client_secret = "tskey-client-..."

# ---- Backups ----
# backup_key comes from the environment: TF_VAR_backup_key=$(scripts/backup-key.sh)  (the Makefile does this)
# Longhorn volume backups → S3-compatible bucket (B2 recommended: versioning on, lifecycle "keep prior versions 30 days").
# Bucket, region and path go in gitops/longhorn/values.yaml (backupTarget); the endpoint + a bucket-scoped key pair here.
longhorn_s3_endpoint   = "https://s3.eu-central-003.backblazeb2.com"
longhorn_s3_access_key = "003..."
longhorn_s3_secret_key = "K003..."
