{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "mise": {
    "enabled": true
  },
  "argocd": {
    "managerFilePatterns": [
      "/^gitops/bootstrap/templates/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": [
        "k3s_version:\\s*\"(?<currentValue>v[\\d.]+\\+k3s\\d+)\""
      ],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^ansible/group_vars/all\\.yml$/"
      ],
      "matchStrings": [
        "smartctl_exporter_version:\\s*\"(?<currentValue>[\\d.]+)\""
      ],
      "depNameTemplate": "prometheus-community/smartctl_exporter",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^gitops/system-upgrade/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "system-upgrade-controller/releases/download/(?<currentValue>v[\\d.]+)/"
      ],
      "depNameTemplate": "rancher/system-upgrade-controller",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^tofu/variables\\.tf$/"
      ],
      "matchStrings": [
        "argocd_apps_chart_version[\\s\\S]*?default\\s*=\\s*\"(?<currentValue>[\\d.]+)\""
      ],
      "depNameTemplate": "argocd-apps",
      "datasourceTemplate": "helm",
      "registryUrlTemplate": "https://argoproj.github.io/argo-helm"
    },
    {
      "customType": "regex",
      "description": "Immich release pinned in the chart values (chart lags Immich)",
      "managerFilePatterns": [
        "/^gitops/immich/values\\.yaml$/"
      ],
      "matchStrings": [
        "tag: (?<currentValue>v\\d+\\.\\d+\\.\\d+)\\s+# Immich release"
      ],
      "depNameTemplate": "immich-app/immich",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Renovate must not bump itself (owner updates the chart pin by hand)",
      "matchDepNames": [
        "renovate"
      ],
      "enabled": false
    },
    {
      "matchDepNames": [
        "kube-prometheus-stack"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "prBodyNotes": [
        "Major bump: read the chart's upgrade notes \u2014 CRD changes may need a manual step."
      ]
    }
  ]
}
