# cp .env.example .env  — loaded automatically by mise. NEVER commit .env.
K3S_TOKEN=                       # openssl rand -hex 32
TAILSCALE_AUTHKEY=               # reusable + pre-authorized + tagged
STORAGEBOX_USER=u123456          # Hetzner Storage Box user (also a sub-account works)
STORAGEBOX_HOST=u123456.your-storagebox.de
STORAGEBOX_PASSWORD=             # only needed once, to install the SSH key on the box
BACKUP_SSH_PUBKEY=~/.ssh/id_ed25519.pub   # Ed25519/RSA pubkey whose agent-signature derives BACKUP_KEY (never change after first bootstrap)
